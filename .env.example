# =============================================================================
# Backend (FastAPI) configuration — copy to .env and fill in real values.
# Variable names MUST match app/core/config.py (pydantic BaseSettings).
# =============================================================================

# --- App ---
ENVIRONMENT="development"           # development | production | test
LOG_LEVEL="INFO"
CORS_ORIGINS="http://localhost:3000"  # comma-separated list

# --- Database (required) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resume_db?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379/0"

# --- Security (required) ---
SECRET_KEY="change-me-to-a-long-random-string"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- File storage ---
STORAGE_BACKEND="local"             # local | s3
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# --- S3 (only when STORAGE_BACKEND=s3) ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_S3_REGION="us-east-1"

# --- LLM ---
LLM_PROVIDER="openai"               # openai | anthropic | ollama
LLM_MODEL="gpt-4o"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# --- Celery ---
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# =============================================================================
# Frontend (Next.js) — set in frontend/.env.local
# =============================================================================
# NEXT_PUBLIC_API_URL="http://localhost:8000"
# NEXT_PUBLIC_WS_URL="ws://localhost:8000"
